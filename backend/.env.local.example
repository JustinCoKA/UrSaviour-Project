# ========================================
# UrSaviour Backend - Local Development
# ========================================
# Copy this file to .env and choose your database setup

# ========================================
# Database Configuration
# ========================================
# OPTION 1: AWS RDS MySQL (Team shared database)
# - Requires: VPN or IP whitelisting in AWS Security Group
# - Advantage: Same data across all team members
# DATABASE_URL=mysql+pymysql://admin:YOUR_RDS_PASSWORD@ursaviour-db.cp4emoqegwfy.ap-southeast-2.rds.amazonaws.com:3306/ursaviourDb

# OPTION 2: Local MySQL (Docker Compose) - RECOMMENDED FOR LOCAL DEV
# - Requires: docker-compose up -d mysql
# - Advantage: Works offline, fast
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/ursaviourDb

# OPTION 3: Local MySQL (Docker service name)
# - Use this if running backend inside Docker
# DATABASE_URL=mysql+pymysql://root:rootpassword@mysql:3306/ursaviourDb

# ========================================
# API Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=local

# ========================================
# CORS Configuration (Allow local frontend)
# ========================================
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://localhost:63342

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET_KEY=local-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ========================================
# Redis Configuration (Optional)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# AWS Configuration (Optional - for S3/Lambda testing)
# ========================================
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_BUCKET_NAME=ursaviour-pamphlets

# ========================================
# Email Configuration (Optional)
# ========================================
SMTP_HOST=localhost
SMTP_PORT=1025
# For production:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
