# Team Shared Database Environment Configuration
# Copy this to .env and use for connecting to Mimi's local database

# Database Configuration - Connect to Mimi's local MySQL
DATABASE_URL=mysql+pymysql://ursaviouruser:securepassword@172.16.38.147:3306/ursaviour

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS Configuration
AWS_REGION=ap-southeast-2

# Optional: OpenAI API (uncomment and add your key if needed)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Email Configuration (uncomment and configure if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password