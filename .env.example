# ========================
# UrSaviour Project Environment Variables
# Copy this file to .env and fill in your actual values
# ========================

# ===== Database Configuration =====
# Choose one configuration method:

# Option 1: Docker MySQL (default for local development)
DATABASE_URL=mysql+pymysql://ursaviouruser:securepassword@db:3306/ursaviour
# Optional split DBs (leave empty to use DATABASE_URL)
# AUTH_DATABASE_URL=                          # e.g., mysql+pymysql://ursaviouruser:securepassword@db:3306/ursaviour
# PRODUCTS_DATABASE_URL=                      # e.g., mysql+pymysql://user:pass@<leader-ec2-or-team-ip>:3306/ursaviour
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ursaviour
MYSQL_USER=ursaviouruser
MYSQL_PASSWORD=securepassword

# Option 2: Team shared database (uncomment to use)
# DATABASE_URL=mysql+pymysql://ursaviouruser:securepassword@172.16.38.147:3306/ursaviour

# Option 3: EC2 production database (uncomment for deployment)
# DATABASE_URL=mysql+pymysql://ursaviouruser:securepassword123!@localhost:3306/ursaviour

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== JWT Authentication =====
# Generate a secure secret key: python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== CORS Configuration =====
# Frontend origins allowed to access the API
BACKEND_CORS_ORIGINS=["http://localhost:3001", "http://localhost:8080", "https://yourdomain.com"]

# ===== OpenAI API Configuration =====
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# ===== Email Configuration =====
# SMTP settings for sending notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@ursaviour.com
FROM_NAME="UrSaviour Team"

# ===== File Upload Configuration =====
# Maximum file size for PDF uploads (in bytes)
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=data/uploads

# ===== ETL Configuration =====
# PDF processing settings
PDF_PROCESSING_TIMEOUT=300  # 5 minutes
ETL_BATCH_SIZE=1000
ETL_LOG_LEVEL=INFO

# ===== API Configuration =====
# FastAPI settings
API_V1_STR="/api/v1"
PROJECT_NAME="UrSaviour API"
DEBUG=True  # Set to False in production
API_HOST=0.0.0.0
API_PORT=8000

# ===== Frontend Configuration =====
FRONTEND_URL=http://localhost:3001
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3001

# ===== AWS Configuration =====
# AWS settings for production deployment
AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=ursaviour-data
# AWS_RDS_ENDPOINT=your-rds-endpoint.amazonaws.com

# ===== Monitoring & Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SENTRY_DSN=""  # Optional: Sentry for error tracking

# ===== Security Configuration =====
# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=True
REQUIRE_LOWERCASE=True  
REQUIRE_NUMBERS=True
REQUIRE_SPECIAL_CHARS=True

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ===== Cache Configuration =====
CACHE_TTL=3600  # 1 hour
CACHE_PREFIX="ursaviour:"

# ===== Development Settings =====
# Set to True to enable debug features
ENABLE_DEBUG_ROUTES=True
ENABLE_API_DOCS=True
ENABLE_MOCK_DATA=True

# ===== Production Settings =====
# Uncomment for production deployment
# DEBUG=False
# ENABLE_DEBUG_ROUTES=False
# ENABLE_MOCK_DATA=False
# USE_HTTPS=True
# SECURE_COOKIES=True